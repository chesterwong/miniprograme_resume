/* 学习履历 - 多皮肤 */
.container {
  padding: 36rpx 32rpx 56rpx;
  min-height: 100vh;
}

.theme-default .container { background: #f0f2f5; }
.theme-dark .container { background: #1a1a1a; }
.theme-mint .container { background: #f2f8f6; }

.page-desc {
  display: block;
  font-size: 26rpx;
  color: #6b8a82;
  line-height: 1.7;
  margin-bottom: 44rpx;
  padding: 0 4rpx;
}

.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 44rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -40rpx;
  top: 16rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7ec8b5 0%, #9ad4c4 100%);
  border: 6rpx solid #f2f8f6;
  box-shadow: 0 0 0 2rpx rgba(126, 200, 181, 0.4);
  z-index: 2;
}

.timeline-line {
  position: absolute;
  left: -31rpx;
  top: 44rpx;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(180deg, #c8e4dc 0%, #e2f0ec 100%);
  z-index: 1;
}

.timeline-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(94, 186, 168, 0.08);
  position: relative;
  overflow: hidden;
}

.timeline-content::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #7ec8b5 0%, #b8e0d4 100%);
  border-radius: 6rpx 0 0 6rpx;
}

.timeline-time {
  display: inline-block;
  font-size: 22rpx;
  color: #4a9b88;
  background: rgba(126, 200, 181, 0.15);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}

.timeline-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2d4a44;
  margin-bottom: 14rpx;
  line-height: 1.4;
}

.timeline-desc {
  display: block;
  font-size: 26rpx;
  color: #5a726c;
  line-height: 1.68;
}

.theme-default .page-desc { color: #666; }
.theme-default .timeline-content { box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.theme-default .timeline-content::before { background: #07c160; }
.theme-default .timeline-time { color: #07c160; background: rgba(7,193,96,0.1); }
.theme-default .timeline-title { color: #333; }
.theme-default .timeline-desc { color: #555; }
.theme-default .timeline-dot { background: #07c160; }
.theme-default .timeline-line { background: #e8e8e8; }

.theme-dark .page-desc { color: #b0b0b0; }
.theme-dark .timeline-content { background: #2d2d2d; box-shadow: none; border: 2rpx solid #3d3d3d; }
.theme-dark .timeline-content::before { background: #5ebaa8; }
.theme-dark .timeline-time { color: #7ec8b5; background: rgba(126,200,181,0.2); }
.theme-dark .timeline-title { color: #fff; }
.theme-dark .timeline-desc { color: #b0b0b0; }
.theme-dark .timeline-dot { background: #5ebaa8; border-color: #1a1a1a; }
.theme-dark .timeline-line { background: #444; }
.theme-dark .timeline-dot { border-color: #1a1a1a; }
