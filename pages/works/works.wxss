/* 作品分享 - 多皮肤 */
.container {
  padding: 36rpx 32rpx 56rpx;
  min-height: 100vh;
}

.theme-default .container { background: #f0f2f5; }
.theme-dark .container { background: #1a1a1a; }
.theme-mint .container { background: #f2f8f6; }

.page-desc {
  display: block;
  font-size: 26rpx;
  color: #6b8a82;
  line-height: 1.7;
  margin-bottom: 40rpx;
  padding: 0 4rpx;
}

.works-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.work-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(94, 186, 168, 0.08);
  position: relative;
  overflow: hidden;
}

.work-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #7ec8b5 0%, #b8e0d4 100%);
  border-radius: 6rpx 0 0 6rpx;
}

.work-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.work-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d4a44;
  flex: 1;
  line-height: 1.4;
}

.work-time {
  font-size: 22rpx;
  color: #9bb5ad;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.work-desc {
  font-size: 26rpx;
  color: #5a726c;
  line-height: 1.68;
  display: block;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.work-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding-left: 8rpx;
}

.tag {
  font-size: 22rpx;
  color: #4a9b88;
  background: rgba(126, 200, 181, 0.15);
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
}

.theme-default .page-desc { color: #666; }
.theme-default .work-card { box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.theme-default .work-card::before { background: #07c160; }
.theme-default .work-title { color: #333; }
.theme-default .work-desc { color: #555; }
.theme-default .work-time { color: #999; }
.theme-default .tag { color: #07c160; background: rgba(7,193,96,0.1); }

.theme-dark .page-desc { color: #b0b0b0; }
.theme-dark .work-card { background: #2d2d2d; box-shadow: none; border: 2rpx solid #3d3d3d; }
.theme-dark .work-card::before { background: #5ebaa8; }
.theme-dark .work-title { color: #fff; }
.theme-dark .work-desc { color: #b0b0b0; }
.theme-dark .work-time { color: #666; }
.theme-dark .tag { color: #7ec8b5; background: rgba(126,200,181,0.2); }
