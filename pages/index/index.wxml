<!--index.wxml-->
<navigation-bar title="Chester's resume" back="{{false}}" color="{{theme === 'dark' ? '#fff' : 'black'}}" background="{{theme === 'dark' ? '#1a1a1a' : (theme === 'mint' ? '#fff' : '#FFF')}}"></navigation-bar>

<view class="page theme-{{theme}}">
  <!-- Header: 轮播 -->
  <view class="header">
    <swiper
      class="banner-swiper"
      indicator-dots="{{true}}"
      indicator-color="rgba(255,255,255,0.4)"
      indicator-active-color="#fff"
      autoplay="{{true}}"
      interval="{{4000}}"
      circular="{{true}}"
      duration="{{300}}"
    >
      <swiper-item wx:for="{{bannerList}}" wx:key="url">
        <view class="banner-item">
          <image class="banner-img" src="{{item.url}}" mode="aspectFill" />
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- Content: Tab -->
  <view class="content">
    <view class="tabs">
      <view class="tab-item {{activeTab === 0 ? 'active' : ''}}" data-index="0" bindtap="onTabTap">Front End</view>
      <view class="tab-item {{activeTab === 1 ? 'active' : ''}}" data-index="1" bindtap="onTabTap">Back End</view>
      <view class="tab-item {{activeTab === 2 ? 'active' : ''}}" data-index="2" bindtap="onTabTap">SQL</view>
    </view>
    <view class="tab-panels">
      <view class="tab-panel" wx:if="{{activeTab === 0}}">
        <text class="panel-title">Front End</text>
        <view class="skill-list">
          <view class="skill-item" wx:for="{{frontEndItems}}" wx:key="*this">
            <text class="skill-dot">·</text>
            <text class="skill-text">{{item}}</text>
          </view>
        </view>
      </view>
      <view class="tab-panel" wx:if="{{activeTab === 1}}">
        <text class="panel-title">Back End</text>
        <view class="skill-list">
          <view class="skill-item" wx:for="{{backEndItems}}" wx:key="*this">
            <text class="skill-dot">·</text>
            <text class="skill-text">{{item}}</text>
          </view>
        </view>
      </view>
      <view class="tab-panel" wx:if="{{activeTab === 2}}">
        <text class="panel-title">SQL</text>
        <view class="skill-list">
          <view class="skill-item" wx:for="{{sqlItems}}" wx:key="*this">
            <text class="skill-dot">·</text>
            <text class="skill-text">{{item}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Bottom: 菜单 -->
  <view class="bottom-menu">
    <view class="menu-item" data-path="/pages/profile/profile" bindtap="onMenuTap">
      <text class="menu-icon">👤</text>
      <text class="menu-label">个人介绍</text>
    </view>
    <view class="menu-item" data-path="/pages/works/works" bindtap="onMenuTap">
      <text class="menu-icon">📂</text>
      <text class="menu-label">作品分享</text>
    </view>
    <view class="menu-item" data-path="/pages/resume/resume" bindtap="onMenuTap">
      <text class="menu-icon">📋</text>
      <text class="menu-label">学习履历</text>
    </view>
    <view class="menu-item" data-path="/pages/user/user" bindtap="onMenuTap">
      <text class="menu-icon">⚙️</text>
      <text class="menu-label">用户中心</text>
    </view>
  </view>
</view>
