page {
  height: 100vh;
  background: #f0f2f5;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* Header: 4 张轮播图 */
.header {
  width: 100%;
  flex-shrink: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.banner-swiper {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.banner-item {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 20rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #1a1a1a;
}

/* Content: 3 个 Tabs */
.content {
  flex: 1;
  margin: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  min-height: 280rpx;
}

.tabs {
  display: flex;
  border-bottom: 2rpx solid #eee;
  background: #fafafa;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 16rpx;
  font-size: 30rpx;
  color: #666;
}

.tab-item.active {
  color: #07c160;
  font-weight: 600;
  background: #fff;
  border-bottom: 4rpx solid #07c160;
  margin-bottom: -2rpx;
}

.tab-panels {
  flex: 1;
  padding: 36rpx 32rpx;
  min-height: 200rpx;
}

.tab-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.panel-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.65;
}

/* Bottom: 个人介绍 / 作品分享 / 学习履历 / 用户中心 */
.bottom-menu {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 16rpx;
  flex: 1;
  max-width: 25%;
}

.menu-icon {
  font-size: 44rpx;
  line-height: 1;
}

.menu-label {
  font-size: 22rpx;
  color: #333;
}

/* 首页皮肤 */
.theme-dark .page { background: #1a1a1a; }
.theme-dark .content { background: #2d2d2d; box-shadow: none; }
.theme-dark .tabs { background: #252525; border-color: #444; }
.theme-dark .tab-item { color: #b0b0b0; }
.theme-dark .tab-item.active { color: #7ec8b5; background: #2d2d2d; border-color: #7ec8b5; }
.theme-dark .panel-title,
.theme-dark .skill-text { color: #e8e8e8; }
.theme-dark .skill-dot { color: #7ec8b5; }
.theme-dark .bottom-menu { background: #1a1a1a; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.3); }
.theme-dark .menu-label { color: #e8e8e8; }

.theme-mint .page { background: #f2f8f6; }
.theme-mint .content { background: #fff; box-shadow: 0 8rpx 32rpx rgba(94,186,168,0.08); }
.theme-mint .tabs { background: #f0f7f4; border-color: #c8e4dc; }
.theme-mint .tab-item { color: #5a726c; }
.theme-mint .tab-item.active { color: #4a9b88; background: #fff; border-color: #7ec8b5; }
.theme-mint .panel-title,
.theme-mint .skill-text { color: #2d4a44; }
.theme-mint .skill-dot { color: #7ec8b5; }
.theme-mint .bottom-menu { background: #fff; box-shadow: 0 -4rpx 20rpx rgba(94,186,168,0.1); }
.theme-mint .menu-label { color: #2d4a44; }
