page {
  height: 100vh;
  background: #f0f2f5;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* Header: 4 张轮播图 */
.header {
  width: 100%;
  flex-shrink: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.banner-swiper {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.banner-item {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 20rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #1a1a1a;
}

/* Content: 3 个 Tabs */
.content {
  flex: 1;
  margin: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  min-height: 280rpx;
}

.tabs {
  display: flex;
  border-bottom: 2rpx solid #eee;
  background: #fafafa;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 16rpx;
  font-size: 30rpx;
  color: #666;
}

.tab-item.active {
  color: #07c160;
  font-weight: 600;
  background: #fff;
  border-bottom: 4rpx solid #07c160;
  margin-bottom: -2rpx;
}

.tab-panels {
  flex: 1;
  padding: 36rpx 32rpx;
  min-height: 200rpx;
}

.tab-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.panel-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.65;
}

/* Bottom: 个人介绍 / 作品分享 / 学习履历 / 用户中心 */
.bottom-menu {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 16rpx;
  flex: 1;
  max-width: 25%;
}

.menu-icon {
  font-size: 44rpx;
  line-height: 1;
}

.menu-label {
  font-size: 22rpx;
  color: #333;
}
